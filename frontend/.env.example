# ==============================================================================
# Folium SIGB Frontend — Environment Variables Template (.env.example)
# ==============================================================================

# Nombre de la aplicación
VITE_APP_NAME=Folium

# Endpoint base de la API REST (Laravel v1)
# En desarrollo: http://localhost:8000/api/v1
# En producción: https://api.folium.biblioteca.org/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Configuración de WebSockets en Tiempo Real (Laravel Reverb)
VITE_REVERB_APP_KEY=folium_reverb_key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
