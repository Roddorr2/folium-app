# ==============================================================================
# Folium SIGB Backend — Configuration Template (.env.example)
# ==============================================================================

# Entorno y Depuración (En producción: APP_ENV=production, APP_DEBUG=false)
APP_NAME=Folium
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de Datos Relacional (MySQL 8.0 / PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=folium_db
DB_USERNAME=root
DB_PASSWORD=secret

# Caché y Gestión de Colas (Redis)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Buscador Full-Text Desacoplado (Meilisearch vía Laravel Scout)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# WebSockets en Tiempo Real (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=100100
REVERB_APP_KEY=folium_reverb_key
REVERB_APP_SECRET=folium_reverb_secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME="http"

# Autenticación Sanctum & CORS Multi-Sede
# Importante en producción: definir dominios SPA separados por coma sin protocolo
SANCTUM_STATEFUL_DOMAINS="localhost:3000,localhost:3001,127.0.0.1:3000,127.0.0.1:3001"
FRONTEND_URL=http://localhost:3001

# Servicio de Correo Electrónico
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="notificaciones@folium.local"
MAIL_FROM_NAME="${APP_NAME}"
